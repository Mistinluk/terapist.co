        text mfa_sirri "Şifreli; boş olabilir"
    }

    uzmanlar {
        string id PK
        string kullanici_id FK, UK
        string ad
        string sehir
        integer ucret
        json calisma_saatleri
        boolean onayli
        boolean arsivli
    }

    oturumlar {
        string ozet PK "Oturum belirteci özeti"
        string kullanici_id FK
        string csrf_ozeti
        integer olusturma "Unix saniye"
        integer son_erisim "Unix saniye"
    }

    randevular {
        string id PK
        string uzman_id FK
        integer baslangic "Unix saniye"
        text danisan_sifreli "Şifreli ad ve telefon"
        string durum
        integer olusturma "Unix saniye"
        string aydinlatma_surumu
    }

    tavsiyeler {
        string veren_id PK, FK "Tavsiye eden uzman"
        string alan_id PK, FK "Tavsiye edilen uzman"
    }

    denetim {
        string id PK
        integer zaman "Unix saniye"
