ORTAM=gelistirme
# make api + make arayuz için vite; Docker Compose derleme değerini verir.
ARAYUZ_SUNUMU=vite
# Ubuntu/PyCharm aynı Docker PostgreSQL veritabanına yerel porttan bağlanır.
VERITABANI_URL=postgresql+psycopg://terapist:yerel-ornek@127.0.0.1:55432/terapist
# python scripts/yerel_ayarlar.py ile rastgele anahtarları oluşturun.
SIFRELEME_ANAHTARI=
HIZ_SINIRI_ANAHTARI=
UYGULAMA_ADRESI=http://localhost:5173
GUVENILIR_HOSTLAR=["localhost","127.0.0.1","testserver"]
# Üretimde zorunlu:
# REDIS_URL=redis://redis:6379/0
# VERI_SORUMLUSU=...
# AYDINLATMA_SURUMU=2026-01
# AYDINLATMA_METNI=Hukuk incelemesinden geçmiş metin...
# Google Takvim bağlantısı (isteğe bağlı):
# GOOGLE_ISTEMCI_KIMLIGI=
# GOOGLE_ISTEMCI_SIRRI=
# GOOGLE_YONLENDIRME_ADRESI=http://localhost:5173/api/google-takvim/geri-donus
# GOOGLE_WEBHOOK_ADRESI=https://alanadiniz.com/api/google-takvim/webhook
# Google Analytics (GA4) ölçümü ve veri bağlantısı (isteğe bağlı):
# GA_OLCUM_KIMLIGI=G-XXXXXXXXXX
# GA4_MULK_KIMLIGI=123456789
# GOOGLE_ANALITIK_YONLENDIRME_ADRESI=http://localhost:5173/api/google-analitik/geri-donus
